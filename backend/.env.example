# Security
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# Supabase PostgreSQL Configuration
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Supabase Auth JWT Secret (Project Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# DeepSeek AI Agent API (configure credentials only in the backend environment)
AI_AGENT_ENABLED=true
AI_AGENT_DEEPSEEK_API_KEY=
AI_AGENT_DEEPSEEK_MODEL=deepseek-chat
AI_AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_AGENT_TIMEOUT_SECONDS=45
AI_AGENT_MAX_OUTPUT_TOKENS=1024
AI_AGENT_CHAT_RATE=30/min
AI_AGENT_MAX_TOOL_CALLS_PER_TURN=3
AI_AGENT_MAX_TOOL_CALLS_PER_REQUEST=6

# Payment Gateways (VNPay / MoMo)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
