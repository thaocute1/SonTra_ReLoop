# Security
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# Supabase PostgreSQL Configuration
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Supabase Auth JWT Secret (Project Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# OAuth Verification
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# DeepSeek AI Agent API (configure credentials only in the backend environment)
AI_AGENT_ENABLED=true
AI_AGENT_DEEPSEEK_API_KEY=
AI_AGENT_DEEPSEEK_MODEL=deepseek-chat
AI_AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_AGENT_TIMEOUT_SECONDS=45
AI_AGENT_MAX_OUTPUT_TOKENS=2048
AI_AGENT_CHAT_RATE=30/min
AI_AGENT_MAX_TOOL_CALLS_PER_TURN=3
AI_AGENT_MAX_TOOL_CALLS_PER_REQUEST=6

# Health-based tour recommendation
# AI_HEALTH_METHOD: rule (backend rule engine, default) | ai_filter (model proposes filters)
# AI_HEALTH_RECOMMENDATION_ENABLED=false disables both health tools
AI_HEALTH_METHOD=rule
AI_HEALTH_RECOMMENDATION_ENABLED=true

# AI Vendor tour-draft (gợi ý & điền sẵn form tạo trải nghiệm; read-only, không ghi DB)
AI_VENDOR_TOUR_DRAFT_ENABLED=true

# Payment Gateways (VNPay / MoMo)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# PayPal Sandbox only. Never commit real credentials.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_DEMO_VND_PER_USD=25000
PAYPAL_FRONTEND_URL=http://localhost:5173
PAYPAL_WEBHOOK_ID=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
